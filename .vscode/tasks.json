{
    "version": "2.0.0",
    "options": {
        // PLACEHOLDER: folder containing g++.exe / gcc.exe.
        // scripts\build.bat reads MINGW_BIN from the environment, so this one
        // value drives every task below.
        "env": {
            "MINGW_BIN": "C:\\mingw64\\bin"
        }
    },
    "tasks": [
        // =====================================================================
        //  Default path - g++/gcc only, no GNU make required.
        // =====================================================================
        {
            "label": "build debug",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["release"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "rebuild debug",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["debug", "rebuild"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "run debug",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["debug", "run"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": ["clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },

        // =====================================================================
        //  Optional - only if your MinGW ships mingw32-make.exe.
        //  Check with:  dir C:\mingw64\bin\*make*
        // =====================================================================
        {
            "label": "make: build debug",
            "type": "shell",
            "command": "${env:MINGW_BIN}\\mingw32-make.exe",
            "args": ["CONFIG=debug", "MINGW_BIN=${env:MINGW_BIN}", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "make: build release",
            "type": "shell",
            "command": "${env:MINGW_BIN}\\mingw32-make.exe",
            "args": ["CONFIG=release", "MINGW_BIN=${env:MINGW_BIN}", "-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "make: show build config",
            "type": "shell",
            "command": "${env:MINGW_BIN}\\mingw32-make.exe",
            "args": ["info", "MINGW_BIN=${env:MINGW_BIN}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
