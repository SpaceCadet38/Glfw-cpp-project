{
    "version": "2.0.0",
    "options": {
        // PLACEHOLDER: folder containing g++.exe / gcc.exe / mingw32-make.exe.
        // Prepending it to PATH is what lets the build find the toolchain
        // without installing MinGW globally.
        "env": {
            "MINGW_BIN": "C:/mingw64/bin",
            "PATH": "C:/mingw64/bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "command": "${env:MINGW_BIN}/mingw32-make.exe",
            "args": [
                "CONFIG=debug",
                "MINGW_BIN=${env:MINGW_BIN}",
                "-j4"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "${env:MINGW_BIN}/mingw32-make.exe",
            "args": [
                "CONFIG=release",
                "MINGW_BIN=${env:MINGW_BIN}",
                "-j4"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "${env:MINGW_BIN}/mingw32-make.exe",
            "args": ["clean", "MINGW_BIN=${env:MINGW_BIN}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "rebuild debug",
            "dependsOrder": "sequence",
            "dependsOn": ["clean", "build debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "run debug",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/app.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["build debug"],
            "problemMatcher": []
        },
        {
            "label": "show build config",
            "type": "shell",
            "command": "${env:MINGW_BIN}/mingw32-make.exe",
            "args": ["info", "MINGW_BIN=${env:MINGW_BIN}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
