{
    // =====================================================================
    //  PLACEHOLDER PATHS - change these two to match your machine.
    //  Everything else (tasks, launch, IntelliSense) reads them from here.
    // =====================================================================
    "mingw.bin": "C:/mingw64/bin",

    "files.associations": {
        "*.h": "c",
        "*.hpp": "cpp",
        "*.inl": "cpp"
    },

    // Use the MinGW make that ships next to gcc, not a system one.
    "makefile.makePath": "C:/mingw64/bin/mingw32-make.exe",

    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "C_Cpp.default.compilerPath": "C:/mingw64/bin/g++.exe",

    "terminal.integrated.defaultProfile.windows": "Command Prompt"
}
